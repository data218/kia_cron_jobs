# =============================================================================
# Environment variables for the NEWLY ADDED crons only.
#
# Merge these into your existing .env — this file is a reference, not a
# replacement. Values shown are the code defaults; only the ones marked
# REQUIRED have no default and must be set.
#
# This file is safe to commit: it contains NO real credentials.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. HIIB INSURANCE  (ha.hiib.in)
#    PM2: hiib-insurance-hyundai, hiib-insurance-platinum   — daily 18:10
#    ->   hyundai_insurance_policy_summary
#    ->   am_platinum_insurance_policy_summary
# -----------------------------------------------------------------------------

# Hyundai login. REQUIRED — no default; config.js will not fall back.
HIIB_USER_ID=
HIIB_PASSWORD=

# AM Platinum login (locked server-side to dealer N5211). REQUIRED.
HIIB_PLATINUM_USER_ID=
HIIB_PLATINUM_PASSWORD=

HIIB_BASE_URL=https://ha.hiib.in
HIIB_LOGIN_URL=https://ha.hiib.in/
HIIB_DASHBOARD_URL=https://ha.hiib.in/Dashboard/Welcome
HIIB_POLICY_SUMMARY_REPORT_URL=https://ha.hiib.in/Report/Report/policysummaryreport

# Leave blank to read the dealer code off the page (logins are dealer-locked).
HIIB_DEALER_CODE=

# 'auto' reads the captcha answer the portal exposes client-side.
# 'manual' waits for a human to type it — only usable with a visible browser.
HIIB_CAPTCHA_MODE=auto
HIIB_MANUAL_CAPTCHA_WAIT_MS=60000
HIIB_MANUAL_CAPTCHA_POLL_MS=1000

HIIB_HEADLESS=false
HIIB_FORCE_LOGIN=false
HIIB_LOGIN_RETRIES=2
HIIB_SESSION_CHECK_TIMEOUT_MS=20000
HIIB_OTP_PROVIDER=manual
HIIB_OTP_WAIT_MS=120000
HIIB_SESSION_STATE_PATH=./storage/hiib-insurance-state.json
HIIB_PLATINUM_SESSION_STATE_PATH=./storage/hiib-platinum-state.json
HIIB_DOWNLOAD_DIR=./downloads/hiib-insurance
HIIB_REPORT_CHUNKS_DIR=./downloads/report-chunks/hiib-insurance
HIIB_DATE_FORMAT=DD/MM/YYYY
HIIB_CRON_SCHEDULE=30 18 * * *
HIIB_CRON_TIMEZONE=Asia/Kolkata

HYUNDAI_INSURANCE_REPORT_SHEET_NAME=hyundai_insurance_policy_summary
HIIB_PLATINUM_SHEET_NAME=am_platinum_insurance_policy_summary
HYUNDAI_INSURANCE_REPORT_BACKFILL_START_DATE=2024-04-01
# The portal's own Validate() rejects ranges wider than 62 days.
HYUNDAI_INSURANCE_REPORT_CHUNK_DAYS=60
HYUNDAI_INSURANCE_REPORT_POST_SEARCH_DELAY_MS=5000
HYUNDAI_INSURANCE_REPORT_BETWEEN_CHUNKS_DELAY_MS=4000
HYUNDAI_INSURANCE_REPORT_DOWNLOAD_TIMEOUT_MS=60000
HYUNDAI_INSURANCE_REPORT_EXPORT_ATTEMPTS=2
# The portal allows only ~3 CSV exports per day, so rows are read from the grid.
HYUNDAI_INSURANCE_REPORT_USE_CSV_EXPORT=false


# -----------------------------------------------------------------------------
# 2. HYUNDAI BOOKING REPORT  (HMIL DMS > MIS > Booking Reports)
#    PM2: hyundai-booking-report   — daily 17:20
#    ->   hyundai_booking_report        (hmil-booking login)
#    ->   am_platinum_booking_report    (am-platinum login)
# -----------------------------------------------------------------------------

# Dedicated HMIL DMS login used ONLY by the Booking Report.
# Separate from HMIL_SECONDARY_USER_ID, which every other HMIL report uses.
# REQUIRED — password has no default.
HMIL_BOOKING_USER_ID=
HMIL_BOOKING_PASSWORD=

HMIL_BOOKING_DEALER_CODES=N5216,N6844,N6845,N6846,N6847,N6848
HMIL_BOOKING_SESSION_STATE_PATH=./storage/hmil-booking-dms-state.json

HYUNDAI_BOOKING_REPORT_PAGE_SIZE=300
HYUNDAI_BOOKING_REPORT_POST_SEARCH_DELAY_MS=5000
HYUNDAI_BOOKING_REPORT_BETWEEN_CHUNKS_DELAY_MS=4000


# -----------------------------------------------------------------------------
# 3. INTERAKT SOCIAL-MEDIA LEADS  (app.interakt.ai)
#    PM2: interakt-leads          — every 10 min, 09:00-17:50
#         interakt-leads-evening  — 18:00, 18:10, 18:20, 18:30
#    ->   social_media_leads
#
#    First run must be VISIBLE so the WhatsApp OTP can be typed in; the saved
#    session then carries the headless cron.
# -----------------------------------------------------------------------------

# REQUIRED — password has no default.
INTERAKT_USER_ID=
INTERAKT_PASSWORD=

INTERAKT_LOGIN_URL=https://app.interakt.ai/login
INTERAKT_INBOX_URL=https://app.interakt.ai/inbox
INTERAKT_SESSION_STATE_PATH=./storage/interakt-state.json
INTERAKT_LEADS_SHEET_NAME=social_media_leads
# Only conversations newer than this are captured.
INTERAKT_LEAD_MAX_AGE_DAYS=7
INTERAKT_CRON_SCHEDULE=*/10 9-18 * * *


# -----------------------------------------------------------------------------
# 4. NEW HYUNDAI REPORT MODULES  (manual / backfill runners, not on a cron yet)
#    -> hyundai_sales_report, hyundai_purchase_report,
#       hyundai_receipt_report, hyundai_enquiry_report
# -----------------------------------------------------------------------------

HYUNDAI_SALES_REPORT_SHEET_NAME=hyundai_sales_report
HYUNDAI_SALES_REPORT_PAGE_SIZE=1000
HYUNDAI_SALES_REPORT_BACKFILL_START_DATE=2021-01-01
HYUNDAI_SALES_REPORT_POST_SEARCH_DELAY_MS=5000
HYUNDAI_SALES_REPORT_BETWEEN_CHUNKS_DELAY_MS=4000

HYUNDAI_PURCHASE_REPORT_SHEET_NAME=hyundai_purchase_report
HYUNDAI_PURCHASE_REPORT_PAGE_SIZE=300
HYUNDAI_PURCHASE_REPORT_BACKFILL_START_DATE=2021-01-01
HYUNDAI_PURCHASE_REPORT_POST_SEARCH_DELAY_MS=5000
HYUNDAI_PURCHASE_REPORT_BETWEEN_CHUNKS_DELAY_MS=4000

HYUNDAI_RECEIPT_REPORT_SHEET_NAME=hyundai_receipt_report
HYUNDAI_RECEIPT_REPORT_PAGE_SIZE=1000
HYUNDAI_RECEIPT_REPORT_BACKFILL_START_DATE=2021-01-01
HYUNDAI_RECEIPT_REPORT_POST_SEARCH_DELAY_MS=5000
HYUNDAI_RECEIPT_REPORT_BETWEEN_CHUNKS_DELAY_MS=4000

HYUNDAI_ENQUIRY_REPORT_SHEET_NAME=hyundai_enquiry_report
HYUNDAI_ENQUIRY_REPORT_PAGE_SIZE=1000
HYUNDAI_ENQUIRY_REPORT_BACKFILL_START_DATE=2021-01-01
HYUNDAI_ENQUIRY_REPORT_POST_SEARCH_DELAY_MS=5000
HYUNDAI_ENQUIRY_REPORT_BETWEEN_CHUNKS_DELAY_MS=4000

# Optional override used by the enquiry backfill runner.
ENQUIRY_BACKFILL_START_DATE=2006-01-01
ENQUIRY_BACKFILL_END_DATE=
ENQUIRY_BACKFILL_HEADLESS=false
